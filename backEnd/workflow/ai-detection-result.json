    {
      "parameters": {
        "functionCode": "const taskInfo = $node['Query Task Info'].json[0];\nconst reportContent = $node['Download Report'].binary.data.toString();\n\nreturn {\n  success: true,\n  task_id: taskInfo.task_id,\n  status: 'completed',\n  progress: 100,\n  project_id: taskInfo.project_id,\n  user_id: taskInfo.user_id,\n  report: {\n    content: reportContent,\n    format: 'markdown'\n  },\n  detection_result: taskInfo.vision_result,\n  analysis_result: taskInfo.llm_result,\n  image_url: `http://ai-detection-minio:9000/ai-detection-bucket/${taskInfo.image_path}`,\n  created_at: taskInfo.created_at,\n  updated_at: taskInfo.updated_at\n};"
      },
