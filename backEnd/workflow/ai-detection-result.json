    {
      "parameters": {
        "functionCode": "const error = $input.all()[0].json.error || $input.all()[0].json;\nconst taskId = $node['Extract TaskID'].json?.task_id || 'unknown';\n\nreturn {\n  success: false,\n  error: error.message || 'Internal server error',\n  task_id: taskId,\n  timestamp: new Date().toISOString()\n};"
      },
