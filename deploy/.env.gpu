# ==============================================
# GPU Mode Configuration
# Usage: cp .env.gpu .env
# ==============================================

# Base Images
BASE_IMAGE=nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04
OCR_BASE_IMAGE=nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04
WELD_BASE_IMAGE=nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Feature Flags
USE_GPU=true
INSTALL_PADDLE=true
SETUP_PYTHON=true

# Docker Compose Config (Enable GPU support overlay)
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# ==============================================
# 存储模式配置（可选）
# 默认使用本地文件系统存储，如需切换到 MinIO，取消下方注释并按需修改
# 前提：MinIO 已通过 Docker 在本机启动并监听 9000 端口
# ==============================================
STORAGE_TYPE=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio123456@!
MINIO_BUCKET=ai-vision-files
