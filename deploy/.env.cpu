# ==============================================
# CPU Mode Configuration
# Usage: cp .env.cpu .env
# ==============================================

# Base Images
BASE_IMAGE=ubuntu:22.04
OCR_BASE_IMAGE=ccr-2vdh3abv-pub.cnc.bj.baidubce.com/paddlepaddle/paddle:3.3.0
WELD_BASE_IMAGE=ubuntu:22.04

# Feature Flags
USE_GPU=false
INSTALL_PADDLE=false
SETUP_PYTHON=false

# Docker Compose Config (Standard only)
COMPOSE_FILE=docker-compose.yml

# ==============================================
# 存储模式配置（可选）
# 默认使用本地文件系统存储，如需切换到 MinIO，取消下方注释并按需修改
# 前提：MinIO 已通过 Docker 在本机启动并监听 9000 端口
# ==============================================
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minio123456@!
# MINIO_BUCKET=ai-vision-files
