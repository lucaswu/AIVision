# ==============================================================================
# AIVision OCR 推理服务 Dockerfile
# 支持 CUDA 12.6 + Python 3.10 + PaddlePaddle
# ==============================================================================

ARG BASE_IMAGE=hub.rat.dev/nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

FROM ${BASE_IMAGE}

ARG USE_GPU=true

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

ARG SETUP_PYTHON=true

# 安装系统依赖
RUN if [ "$SETUP_PYTHON" = "true" ]; then \
    sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/ports.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3.10-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean; \
    fi

# 设置 Python 别名
RUN if [ "$SETUP_PYTHON" = "true" ]; then \
    ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3 /usr/bin/pip; \
    fi

# 升级 pip
RUN if [ "$SETUP_PYTHON" = "true" ]; then \
    pip install --no-cache-dir --upgrade pip setuptools wheel; \
    fi

# 设置工作目录
WORKDIR /app

# 安装 PaddlePaddle (根据 USE_GPU 决定安装 GPU 版还是 CPU 版)
ARG INSTALL_PADDLE=true
RUN if [ "$INSTALL_PADDLE" = "true" ]; then \
    if [ "$USE_GPU" = "true" ]; then \
    pip install --no-cache-dir paddlepaddle-gpu==2.6.1 -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ --trusted-host www.paddlepaddle.org.cn --trusted-host paddle-whl.bj.bcebos.com; \
    else \
    pip install --no-cache-dir paddlepaddle==2.6.2 -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com; \
    fi \
    fi

# 复制依赖文件并安装
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 创建必要目录
RUN mkdir -p /app/data/files /app/data/results /app/cache

# 复制模型代码
COPY . /app/model

# 设置工作目录为模型目录
WORKDIR /app/model

# 暴露端口 (FastAPI 服务)
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
