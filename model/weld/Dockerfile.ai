# ==============================================================================
# AIVision Python AI 推理服务 Dockerfile (含焊缝检测 + OCR)
# 支持 CUDA 12.1 + Python 3.10 + PyTorch + PaddlePaddle
# 构建上下文: model/ 目录 (包含 weld/ 和 OCR/ 子目录)
# ==============================================================================

ARG BASE_IMAGE=nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

FROM ${BASE_IMAGE}

ARG USE_GPU=true

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TORCH_HOME=/app/cache/torch
ENV HF_HOME=/app/cache/huggingface
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
# 确保 PaddlePaddle 能找到系统 cuDNN 库
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/local/nvidia/lib:/usr/local/nvidia/lib64

# 安装系统依赖
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3.10-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 设置 Python 别名
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# 升级 pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 设置工作目录
WORKDIR /app

# ── PaddlePaddle 安装 ─────────────────────────────────────────────────────────
# 根据 USE_GPU 决定安装 GPU 版还是 CPU 版
# CUDA 12.1 镜像兼容 cu118/cu123 版 PaddlePaddle，使用 3.0 GPU 版本
ARG INSTALL_PADDLE=true
RUN if [ "$INSTALL_PADDLE" = "true" ]; then \
    if [ "$USE_GPU" = "true" ]; then \
        pip install --no-cache-dir paddlepaddle-gpu==3.1.0 \
            -i https://www.paddlepaddle.org.cn/packages/stable/cu123/ \
            --extra-index-url https://pypi.tuna.tsinghua.edu.cn/simple \
            --trusted-host www.paddlepaddle.org.cn \
            --trusted-host paddle-whl.bj.bcebos.com \
            --trusted-host pypi.tuna.tsinghua.edu.cn; \
    else \
        pip install --no-cache-dir paddlepaddle==3.1.0 \
            -i https://mirrors.aliyun.com/pypi/simple/ \
            --trusted-host mirrors.aliyun.com; \
    fi \
    fi


# ─────────────────────────────────────────────────────────────────────────────

# 复制依赖文件并安装（构建上下文为 model/ 目录）
COPY weld/requirements.txt .
# PaddleOCR 3.4 与 PaddlePaddle 3.0 兼容，不再有 opencv 版本冲突，直接安装
RUN if [ "$USE_GPU" = "false" ]; then \
    sed -i '/--extra-index-url/d' requirements.txt; \
    fi && \
    pip install --no-cache-dir -r requirements.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn && \
    pip install --no-cache-dir paddleocr==3.4.0 \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn

# 创建必要目录
RUN mkdir -p /app/data/files /app/data/results /app/cache /app/model/weights /app/OCR/utils

# 复制焊缝模型代码
COPY weld/ /app/model/

# 复制 OCR 工具模块（供 run_inference_pipeline.py 的 OCRRunner 使用）
COPY OCR/utils/ /app/OCR/utils/

# 将预下载的 PaddleOCR 模型缓存复制到镜像内
# 离线构建：先在有网络的机器上运行 model/weld/scripts/download_ocr_models.sh，
#           生成 model/weld/weight/paddleocr_cache/，再传到离线机器构建。
# 在线构建：若 paddleocr_cache/ 为空，首次运行时 PaddleOCR 仍会自动下载到
#           /root/.paddleocr/（由 docker-compose 的 named volume 持久化）。
RUN mkdir -p /root/.paddleocr
COPY weld/weight/paddleocr_cache/ /root/.paddleocr/

# 设置工作目录为模型目录
WORKDIR /app/model

# 暴露端口 (FastAPI 服务)
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
