# ==============================================================================
# AIVision Python AI 推理服务 Dockerfile
# 支持 CUDA 12.1 + Python 3.10
# ==============================================================================

ARG BASE_IMAGE=hub.rat.dev/nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

FROM ${BASE_IMAGE}

ARG USE_GPU=true

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TORCH_HOME=/app/cache/torch
ENV HF_HOME=/app/cache/huggingface
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# 安装系统依赖
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    sed -i 's/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3.10-venv \
    python3.10-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 设置 Python 别名
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# 升级 pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 设置工作目录
WORKDIR /app

# 复制依赖文件并安装（分层缓存优化）
# 复制依赖文件并安装（分层缓存优化）
COPY requirements.txt .
RUN if [ "$USE_GPU" = "false" ]; then \
    sed -i '/--extra-index-url/d' requirements.txt; \
    fi && \
    pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --trusted-host pypi.tuna.tsinghua.edu.cn

# 创建必要目录
RUN mkdir -p /app/data/files /app/data/results /app/cache /app/model/weights

# 复制模型代码（排除大文件和不必要的目录）
COPY . /app/model

# 设置工作目录为模型目录
WORKDIR /app/model

# 暴露端口 (FastAPI 服务)
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动命令
CMD ["uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
